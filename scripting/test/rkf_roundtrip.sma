// ---- the checks ---------------------------------------------------------------------------------------

new g_text[KFC_TEXT];
new Float:g_arms[KFC_ARM_FLOATS];
new g_moves[KFC_MAX_COMBOS][KFC_MAX_COMBO_LEN], g_lens[KFC_MAX_COMBOS], Float:g_values[KFC_MAX_COMBOS], g_uses[KFC_MAX_COMBOS], g_count;

// g_text's lines against want.
check_lines(const what[], const want[][], num)
{
	new line = 0, start = 0, got[512];
	new len = strlen(g_text);
	while (start < len)
	{
		new end = start;
		while (end < len && g_text[end] != '^n')
		{
			end++;
		}
		new n = 0;
		for (new i = start; i < end && n < charsmax(got); i++)
		{
			got[n++] = g_text[i];
		}
		got[n] = 0;
		if (line < num)
		{
			check(equal(got, want[line]) != 0, what, got, want[line]);
		}
		else
		{
			check(false, what, got, "(no more lines)");
		}
		line++;
		start = end + 1;
	}
	if (len == 0 || g_text[len - 1] != '^n')
	{
		check(false, what, "(no final newline)", "");
	}
	for (; line < num; line++)
	{
		check(false, what, "(missing)", want[line]);
	}
}

// A fresh fighter's learned part (KungFu::new).
reset_fighter()
{
	for (new i = 0; i < KFC_ARM_FLOATS; i++)
	{
		g_arms[i] = 0.0;
	}
	g_count = kfc_seed_combos(g_moves, g_lens, g_values, g_uses);
}

format_fighter()
{
	kfc_format(g_arms, g_moves, g_lens, g_values, g_uses, g_count, g_text, charsmax(g_text));
}

// A file built from lines joined by sep, read into a fresh fighter, saved again.
check_load(const what[], const lines[][], num, const sep[], const want[][], want_num)
{
	g_text[0] = 0;
	for (new i = 0; i < num; i++)
	{
		if (i > 0)
		{
			add(g_text, charsmax(g_text), sep);
		}
		add(g_text, charsmax(g_text), lines[i]);
	}
	reset_fighter();
	kfc_parse(g_text, g_arms, g_moves, g_lens, g_values, g_uses, g_count);
	format_fighter();
	check_lines(what, want, want_num);
}

// A fighter's save against KungFu::save's, and read back into a fighter knowing nothing.
check_fighter(const what[], const arms[], const moves[][], const lens[], const values[], const uses[], count, const text[][], text_num)
{
	for (new i = 0; i < KFC_ARM_FLOATS; i++)
	{
		g_arms[i] = Float:arms[i];
	}
	for (new c = 0; c < KFC_MAX_COMBOS; c++)
	{
		for (new m = 0; m < KFC_MAX_COMBO_LEN; m++)
		{
			g_moves[c][m] = moves[c][m];
		}
		g_lens[c] = lens[c];
		g_values[c] = Float:values[c];
		g_uses[c] = uses[c];
	}
	g_count = count;
	format_fighter();
	check_lines(what, text, text_num);

	for (new i = 0; i < KFC_ARM_FLOATS; i++)
	{
		g_arms[i] = 0.0;
	}
	g_count = 0;
	new version = kfc_parse(g_text, g_arms, g_moves, g_lens, g_values, g_uses, g_count);
	new got[32], want[32];
	num_to_str(version, got, charsmax(got));
	check(version == KFC_VERSION, what, got, "2");
	for (new i = 0; i < KFC_ARM_FLOATS; i++)
	{
		formatex(got, charsmax(got), "arm float %d: %08x", i, g_arms[i]);
		formatex(want, charsmax(want), "arm float %d: %08x", i, arms[i]);
		check(_:g_arms[i] == arms[i], what, got, want);
	}
	num_to_str(g_count, got, charsmax(got));
	num_to_str(count, want, charsmax(want));
	check(g_count == count, what, got, want);
	for (new c = 0; c < count; c++)
	{
		new bool:same = g_lens[c] == lens[c] && _:g_values[c] == values[c] && g_uses[c] == uses[c];
		for (new m = 0; m < lens[c] && same; m++)
		{
			same = g_moves[c][m] == moves[c][m];
		}
		formatex(got, charsmax(got), "combo %d", c);
		check(same, what, got, same ? got : "differs");
	}
}

check_floats()
{
	new got[64], back[32], want[32];
	for (new i = 0; i < sizeof(RKF_FLOAT_BITS); i++)
	{
		new Float:f = Float:RKF_FLOAT_BITS[i];
		kfc_float_str(f, got, charsmax(got));
		check(equal(got, RKF_FLOAT_TEXT[i]) != 0, "f32 Display", got, RKF_FLOAT_TEXT[i]);
		new Float:r;
		new bool:ok = kfc_parse_float(RKF_FLOAT_TEXT[i], 0, strlen(RKF_FLOAT_TEXT[i]), r);
		new bool:finite = (RKF_FLOAT_BITS[i] & 0x7F800000) != 0x7F800000;
		formatex(back, charsmax(back), "%d %08x", ok, r);
		formatex(want, charsmax(want), "%d %08x", finite, finite ? RKF_FLOAT_BITS[i] : 0);
		check(ok == finite && (!finite || _:r == RKF_FLOAT_BITS[i]), RKF_FLOAT_TEXT[i], back, want);
	}
}

check_file()
{
	static const PATH[] = "rkf_roundtrip.rkf";
	static back[KFC_TEXT];
	reset_fighter();
	format_fighter();
	new len = strlen(g_text);
	check(kfc_write_file(PATH, g_text, len), "write", "false", "true");
	// Twice: the second replaces the first.
	check(kfc_write_file(PATH, g_text, len), "rewrite", "false", "true");
	new n = kfc_read_file(PATH, back, sizeof(back));
	check(n == len && equal(back, g_text) != 0, "read back", back, g_text);
	delete_file(PATH);
}

run_checks()
{
	g_checks = 0;
	g_failed = 0;
	check_floats();
	check_fighter("RKF_A", RKF_A_ARMS, RKF_A_MOVES, RKF_A_LENS, RKF_A_VALUES, RKF_A_USES, RKF_A_COMBOS, RKF_A_TEXT, sizeof(RKF_A_TEXT));
	check_fighter("RKF_B", RKF_B_ARMS, RKF_B_MOVES, RKF_B_LENS, RKF_B_VALUES, RKF_B_USES, RKF_B_COMBOS, RKF_B_TEXT, sizeof(RKF_B_TEXT));
	check_load("garbage", RKF_IN_GARBAGE, sizeof(RKF_IN_GARBAGE), RKF_IN_GARBAGE_SEP, RKF_OUT_GARBAGE, sizeof(RKF_OUT_GARBAGE));
	check_load("newer", RKF_IN_NEWER, sizeof(RKF_IN_NEWER), RKF_IN_NEWER_SEP, RKF_OUT_NEWER, sizeof(RKF_OUT_NEWER));
	check_load("damaged", RKF_IN_DAMAGED, sizeof(RKF_IN_DAMAGED), RKF_IN_DAMAGED_SEP, RKF_OUT_DAMAGED, sizeof(RKF_OUT_DAMAGED));
	check_load("version1", RKF_IN_VERSION1, sizeof(RKF_IN_VERSION1), RKF_IN_VERSION1_SEP, RKF_OUT_VERSION1, sizeof(RKF_OUT_VERSION1));
	check_load("mangled", RKF_IN_MANGLED, sizeof(RKF_IN_MANGLED), RKF_IN_MANGLED_SEP, RKF_OUT_MANGLED, sizeof(RKF_OUT_MANGLED));
	check_load("odd", RKF_IN_ODD, sizeof(RKF_IN_ODD), RKF_IN_ODD_SEP, RKF_OUT_ODD, sizeof(RKF_OUT_ODD));
	check_file();
	server_print("rkf_roundtrip: %d checks, %d failed", g_checks, g_failed);
}

public plugin_init()
{
	register_plugin("rkf_roundtrip", "1.0", "tsmod-amxx-rcbot");
	register_srvcmd("rkf_roundtrip", "cmd_rkf_roundtrip");
	run_checks();
}

public cmd_rkf_roundtrip()
{
	run_checks();
	return PLUGIN_HANDLED;
}
