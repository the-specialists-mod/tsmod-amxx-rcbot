// rkf_roundtrip: checks the Pawn kung fu fighter's .rkf codec (scripting/rcbot/kungfu.inc's kfc_*)
// against what tsmod-rcbot-rs writes and reads: Rust's f32 Display for a set of floats (and its
// parse back), KungFu::save's text for two fighters (and the fighter read back from it), and
// KungFu::load's result for damaged, older, newer and oddly formatted files. The expected data
// below is generated from tsmod-rcbot-rs v0.3.0's rcbot crate (KungFu::save / load, f32's
// Display). It also writes and reads back a file (rkf_roundtrip.rkf in the game directory,
// deleted after). Results go to the server console at plugin_init and with "rkf_roundtrip":
// "rkf_roundtrip: <n> checks, <m> failed", each failure on its own line before it.
// tsmod-amxx-rcbot, GPL-3.0-or-later with the AMX Mod X and RCBot linking exceptions.

#include <amxmodx>

#define RC_KUNGFU_CODEC_ONLY
#include "../rcbot/kungfu.inc"

new g_checks, g_failed;

check(bool:ok, const what[], const got[], const want[])
{
	g_checks++;
	if (!ok)
	{
		g_failed++;
		server_print("rkf_roundtrip: FAIL %s: got ^"%s^", want ^"%s^"", what, got, want);
	}
}

// ---- generated by tsmod-rcbot-rs's rcbot crate ---------------------------------------------------

